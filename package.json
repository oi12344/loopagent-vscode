{
  "name": "loopagent-vscode",
  "displayName": "LoopAgent",
  "version": "0.0.1",
  "publisher": "local-dev",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:loopagent.hello",
    "onCommand:loopagent.focusChat",
    "onCommand:loopagent.setModelApiKey",
    "onCommand:loopagent.clearModelApiKey",
    "onView:loopagent.chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "loopagent.hello",
        "title": "LoopAgent: Hello"
      },
      {
        "command": "loopagent.focusChat",
        "title": "LoopAgent: Focus Chat"
      },
      {
        "command": "loopagent.setModelApiKey",
        "title": "LoopAgent: Set Model API Key"
      },
      {
        "command": "loopagent.clearModelApiKey",
        "title": "LoopAgent: Clear Model API Key"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "loopagent",
          "title": "LoopAgent",
          "icon": "resources/loopagent.svg"
        }
      ]
    },
    "views": {
      "loopagent": [
        {
          "id": "loopagent.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "LoopAgent",
      "properties": {
        "loopagent.model.provider": {
          "type": "string",
          "enum": [
            "fake",
            "deepseek"
          ],
          "default": "fake",
          "description": "Model provider used when running LoopAgent tasks."
        },
        "loopagent.model.model": {
          "type": "string",
          "default": "deepseek-v4-flash",
          "description": "Model name passed to the configured provider."
        },
        "loopagent.model.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional provider base URL override. Leave empty to use the provider default."
        },
        "loopagent.model.thinking": {
          "type": "string",
          "enum": [
            "disabled",
            "enabled"
          ],
          "default": "enabled",
          "description": "Thinking mode for providers that support it."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile -- --production",
    "lint": "echo \"No lint configured yet\"",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "debug:vscode": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-vscode-debug.ps1",
    "package:vsix": "node scripts/package-vsix.mjs",
    "start:vscode:vsix-e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-vscode-vsix-e2e.ps1",
    "test:e2e:code-exploration": "node scripts/run-code-exploration-e2e.mjs",
    "test": "vitest run",
    "test:vscode:sqlite-probe": "node scripts/run-sqlite-vscode-probe.mjs",
    "typecheck": "tsc --noEmit -p ./"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.103.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9",
    "yauzl": "3.2.1"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "web-tree-sitter": "^0.26.10"
  }
}
