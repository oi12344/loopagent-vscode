{
  "name": "loopagent-vscode",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "jest",

    "download:model": "python scripts/download_model.py",

    "package:lite": "vsce package --out dist/loopagent-lite.vsix",
    "package:full": "vsce package --out dist/loopagent-full.vsix",

    "clean": "rm -rf dist build models/moondream2 *.spec"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0",
    "vsce": "^2.15.0"
  }
}
